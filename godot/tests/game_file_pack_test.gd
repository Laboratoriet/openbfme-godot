## Lane IOS-24: the desktop's "Prepare for iPhone / iPad" packer (scripts/release/game_file_pack.gd) against the app's importer
## (scripts/release/game_file_import.gd). Synthetic folders (generated bytes, no game data): what goes in and what stays out, the Adler-32
## helpers against zlib's known values, then pack -> import -> every file byte-identical. Headless, no retail data.
##
## --retail-out=DIR (manual, needs ROTWK_INSTALL / BFME2_INSTALL): the same round trip on the real folders through the game's own mount,
## writing about 6.5 GB into DIR (the file is deleted by the importer once installed; DIR/import is left for the caller to delete) and
## comparing the manifest with --reference=FILE (an .obfme made by tools/ios/make_game_file.py) when given.
extends SceneTree

const Pack := preload("res://scripts/release/game_file_pack.gd")
const Import := preload("res://scripts/release/game_file_import.gd")

var checks := 0
var failed := 0


func check(ok: bool, label: String) -> void:
	checks += 1
	if not ok:
		failed += 1
		printerr("PACK FAIL ", label)


func _initialize() -> void:
	call_deferred("run")


func run() -> void:
	var retail := ""
	var reference := ""
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--retail-out="):
			retail = a.trim_prefix("--retail-out=")
		elif a.begins_with("--reference="):
			reference = a.trim_prefix("--reference=")
	_adler()
	await _synthetic()
	if not retail.is_empty():
		await _retail(retail, reference)
	print("PACK %d checks, %d failed" % [checks, failed])
	quit(1 if failed > 0 else 0)


# zlib's values: adler32(b"Wikipedia") = 0x11E60398; adler32 of 0..255 x 300 bytes, and its halves combined
func _adler() -> void:
	check(Pack.adler32("Wikipedia".to_ascii_buffer()) == 0x11E60398, "adler32(Wikipedia)")
	check(Pack.adler32(PackedByteArray()) == 1, "adler32 of nothing is 1")
	var buf := PackedByteArray()
	for i in 76800:
		buf.append(i & 0xFF)
	var whole := Pack.adler32(buf)
	var halves := Pack.adler32_combine(Pack.adler32(buf.slice(0, 30001)), Pack.adler32(buf.slice(30001)), buf.size() - 30001)
	check(whole == halves, "adler32_combine of two halves = the whole (%x, %x)" % [whole, halves])


func _synthetic() -> void:
	var base := ProjectSettings.globalize_path("user://pack-test")
	_remove_tree(base)
	var rotwk := base.path_join("Games/RotWK")
	var bfme2 := base.path_join("Games/BFME2")
	var rng := RandomNumberGenerator.new()
	rng.seed = 24
	# generated bytes only: a few compressible, most not; one archive is two pieces (CHUNK + 1 MB)
	var made := {
		"RotWK/gi.dat": _bytes(rng, 300, false), "RotWK/Ini.big": _bytes(rng, Pack.CHUNK + (1 << 20), true),
		"RotWK/data/movies/Intro.vp6": _bytes(rng, 700000, false), "RotWK/lang/english.big": _bytes(rng, 120000, true),
		"RotWK/lang/English/Data/Movies/x.vp6": _bytes(rng, 5000, false), "RotWK/game.dat": _bytes(rng, 1000, false),
		"RotWK/Old/_patch999.big": _bytes(rng, 2000, false), "RotWK/notes.txt": _bytes(rng, 10, false),
		"RotWK/EnglishSplash.jpg": _bytes(rng, 9000, false), "RotWK/empty.big": PackedByteArray(),
		"BFME2/gi.dat": _bytes(rng, 300, false), "BFME2/W3D.big": _bytes(rng, 200000, true), "BFME2/mss/mss32.dll": _bytes(rng, 100, false),
		"BFME2/.DS_Store": _bytes(rng, 50, false),
	}
	for rel in made:
		var p := base.path_join("Games").path_join(rel)
		DirAccess.make_dir_recursive_absolute(p.get_base_dir())
		var f := FileAccess.open(p, FileAccess.WRITE)
		f.store_buffer(made[rel])
		f.close()
	var mount := {"ok": true, "rotwk_install": rotwk, "bfme2_install": bfme2, "languages": PackedStringArray(["rotwk:English"]), "mounted": [
		{"install": "rotwk", "disk_path": rotwk.path_join("Ini.big")}, {"install": "rotwk", "disk_path": rotwk.path_join("lang/english.big")},
		{"install": "rotwk", "disk_path": rotwk.path_join("empty.big")}, {"install": "bfme2", "disk_path": bfme2.path_join("W3D.big")},
		{"install": "mod", "disk_path": base.path_join("Mods/x.big")}]}
	var pack := Pack.new()
	check(pack.plan(mount), "plan: " + pack.error)
	var going := pack.files.map(func(f): return f.path)
	# make_game_file.py's order: RotWK, then BFME2, each by lower-case path
	check(going == ["RotWK/data/movies/Intro.vp6", "RotWK/empty.big", "RotWK/EnglishSplash.jpg", "RotWK/gi.dat", "RotWK/Ini.big",
		"RotWK/lang/english.big", "RotWK/lang/English/Data/Movies/x.vp6", "BFME2/gi.dat", "BFME2/W3D.big"], "the files that go in: %s" % str(going))
	var out_names := {}
	for s in pack.skipped:
		out_names[s.path] = s.why
	# (.DS_Store is not even listed: hidden files are not walked)
	check(out_names.size() == 4 and out_names.has("RotWK/game.dat") and out_names.has("RotWK/Old/_patch999.big") and out_names.has("RotWK/notes.txt")
		and out_names.has("BFME2/mss/mss32.dll"), "the files left out: %s" % str(out_names))
	check(pack.games.size() == 2 and pack.games[0].language == "English" and pack.games[1].language == "", "games: %s" % str(pack.games))
	# a mounted archive that is gone is an error, not a silent skip
	var gone := mount.duplicate(true)
	gone.mounted.append({"install": "bfme2", "disk_path": bfme2.path_join("Maps.big")})
	check(not Pack.new().plan(gone), "a mounted archive missing from the folder stops the plan")
	check(not pack.start(rotwk.path_join("x.obfme")), "refuses to write into a game folder")

	var out := base.path_join(Pack.FILE_NAME)
	check(pack.start(out), "start: " + pack.error)
	while pack.is_running():
		await process_frame
	check(pack.wait(), "written: " + str(pack.status()))
	var st := pack.status()
	check(st.phase == "done" and st.done == pack.total and FileAccess.file_exists(out) and not FileAccess.file_exists(out + ".partial"),
		"done, %d of %d bytes" % [st.done, pack.total])

	# the importer reads it and installs every file
	var imp := Import.new()
	imp.root = base.path_join("Import")
	DirAccess.make_dir_recursive_absolute(imp.root)
	check(imp.open(out), "the importer opens it: " + imp.error)
	check(imp.files.size() == pack.files.size() and imp.total == pack.total, "the importer lists %d files, %d bytes" % [imp.files.size(), imp.total])
	check(await imp.run(), "the importer installs it: " + imp.error)
	for item in pack.files:
		var got := FileAccess.get_file_as_bytes(imp.root.path_join(item.path))
		check(got == made[item.path], "%s arrives byte-identical" % item.path)
	check(not FileAccess.file_exists(out), "the importer deleted the game file")

	# cancelling stops and leaves no file behind
	var again := Pack.new()
	again.plan(mount)
	again.start(out)
	again.cancel()
	while again.is_running():
		await process_frame
	again.wait()
	check(again.status().phase == "cancelled" or again.status().phase == "done", "cancelled: " + again.status().phase)
	if again.status().phase == "cancelled":
		check(not FileAccess.file_exists(out) and not FileAccess.file_exists(out + ".partial"), "a cancelled run leaves no file")
	_remove_tree(base)


func _retail(dir: String, reference: String) -> void:
	var fs: RefCounted = ClassDB.instantiate("RetailFileSystem")
	var t0 := Time.get_ticks_msec()
	var mount: Dictionary = fs.mount_retail()
	print("PACK retail mount: ok %s, %d archives (%d ms)" % [mount.ok, mount.get("mounted", []).size(), Time.get_ticks_msec() - t0])
	check(mount.ok, "the game's mount: " + str(mount.get("errors", [])))
	var pack := Pack.new()
	check(pack.plan(mount), "retail plan: " + pack.error)
	print("PACK retail plan: %d files, %d bytes, %d skipped" % [pack.files.size(), pack.total, pack.skipped.size()])
	DirAccess.make_dir_recursive_absolute(dir)
	var out := dir.path_join(Pack.FILE_NAME)
	t0 = Time.get_ticks_msec()
	check(pack.start(out), "retail start: " + pack.error)
	var said := 0
	while pack.is_running():
		await create_timer(1.0).timeout
		var s := pack.status()
		if Time.get_ticks_msec() - said > 30000:
			said = Time.get_ticks_msec()
			print("PACK retail: %.2f of %.2f GB, file %d of %d, %d s left" % [s.done / 1e9, s.total / 1e9, s.index, s.count, s.seconds_left])
	check(pack.wait(), "retail written: " + pack.error)
	var st := pack.status()
	print("PACK retail written: %d bytes in %d s" % [st.size, (Time.get_ticks_msec() - t0) / 1000])
	var imp := Import.new()
	imp.root = dir.path_join("import")
	DirAccess.make_dir_recursive_absolute(imp.root)
	check(imp.open(out), "retail: the importer opens it: " + imp.error)
	if not reference.is_empty():
		var ref := Import.new()
		ref.root = dir.path_join("reference-journal") # read only: open() writes nothing (an empty folder: no journal to find)
		DirAccess.make_dir_recursive_absolute(ref.root)
		check(ref.open(reference), "the reference opens: " + ref.error)
		var mine := imp.files.map(func(f): return [f.path, f.size, f.md5, f.adler32])
		var theirs := ref.files.map(func(f): return [f.path, f.size, f.md5, f.adler32])
		check(mine == theirs, "the file list, sizes, md5s and Adler-32s are make_game_file.py's (%d / %d files)" % [mine.size(), theirs.size()])
		print("PACK retail vs make_game_file.py: %d vs %d bytes (%+d)" % [st.size, ref.archive_size, st.size - ref.archive_size])
	t0 = Time.get_ticks_msec()
	check(await imp.run(), "retail: the importer installs it (every file md5-checked): " + imp.error)
	print("PACK retail imported %d files in %d s" % [imp.files.size(), (Time.get_ticks_msec() - t0) / 1000])


static func _bytes(rng: RandomNumberGenerator, n: int, compressible: bool) -> PackedByteArray:
	var b := PackedByteArray()
	b.resize(n)
	for i in n:
		b[i] = (i % 61) if compressible and (i / 4096) % 2 == 0 else rng.randi() & 0xFF
	return b


static func _remove_tree(path: String) -> void:
	if not DirAccess.dir_exists_absolute(path):
		return
	for d in DirAccess.get_directories_at(path):
		_remove_tree(path.path_join(d))
	for f in DirAccess.get_files_at(path):
		DirAccess.remove_absolute(path.path_join(f))
	DirAccess.remove_absolute(path)
